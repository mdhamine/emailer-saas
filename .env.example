# Auth for the cron endpoint (Vercel sends it automatically as a Bearer token)
CRON_SECRET=generate-a-long-random-string


# Product Hunt developer token: https://www.producthunt.com/v2/oauth/applications
PH_TOKEN=
# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Resend (verify your sending domain first)
RESEND_API_KEY=
FROM_EMAIL=you@mail.yourdomain.com
# Unsubscribe requests and replies land here
REPLY_TO=you@yourdomain.com
SENDER_NAME=Your Name
POSTAL_ADDRESS=Your Company, 123 Street, City, Country
# Where the dry-run digest is sent
OWNER_EMAIL=you@yourdomain.com

# What you are pitching (be specific, 2-4 sentences)
OFFER=Describe your product/service, who it helps, and the concrete outcome.

# Comma-separated emails or domains to never contact. Add people who ask to unsubscribe, then redeploy.
BLOCKLIST=

# Behaviour
DRY_RUN=true
MIN_FIT=7
MAX_PER_RUN=15
